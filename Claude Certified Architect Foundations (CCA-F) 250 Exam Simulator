<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Claude Certified Architect Foundations (CCA-F) — Exam Simulator</title>
<style>
  :root {
    --bg: #f5f7fa;
    --card-bg: #ffffff;
    --accent: #2563eb;
    --accent-dark: #1d4ed8;
    --accent-light: #e0e7ff;
    --text: #1f2937;
    --text-muted: #6b7280;
    --border: #e5e7eb;
    --green: #10b981;
    --green-bg: #d1fae5;
    --green-border: #34d399;
    --green-text: #065f46;
    --red: #ef4444;
    --red-bg: #fee2e2;
    --red-border: #f87171;
    --red-text: #991b1b;
    --amber-bg: #fef3c7;
    --amber-border: #fbbf24;
    --amber-text: #92400e;
    --shadow: 0 2px 8px rgba(0,0,0,0.06);
    --shadow-lg: 0 4px 16px rgba(0,0,0,0.08);
    --radius: 10px;
  }

  * { box-sizing: border-box; }

  body {
    font-family: "Segoe UI", Arial, sans-serif;
    background: var(--bg);
    margin: 0;
    padding: 0;
    color: var(--text);
    line-height: 1.5;
  }

  .app-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 20px 20px 60px;
  }

  header.app-header {
    text-align: center;
    padding: 28px 20px 22px;
    background: linear-gradient(180deg, #ffffff 0%, #f5f7fa 100%);
    border-bottom: 1px solid var(--border);
    margin-bottom: 20px;
  }

  header.app-header h1 {
    margin: 0 0 6px;
    color: #1e3a8a;
    font-size: 1.6em;
  }

  header.app-header p.subtitle {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95em;
  }

  /* Top-level nav tabs */
  .main-nav {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .main-nav button {
    background: var(--card-bg);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 10px 22px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95em;
    cursor: pointer;
    box-shadow: var(--shadow);
    transition: all 0.15s;
  }

  .main-nav button:hover {
    background: var(--accent-light);
  }

  .main-nav button.active {
    background: var(--accent);
    color: white;
    border-color: var(--accent);
  }

  .view-section { display: none; }
  .view-section.active { display: block; }

  /* Cards */
  .card {
    background: var(--card-bg);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 20px 24px;
    margin-bottom: 20px;
  }

  /* Study mode controls */
  .study-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    margin-bottom: 16px;
  }

  .study-controls input[type="text"] {
    flex: 1 1 260px;
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 0.95em;
  }

  .study-controls select {
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 0.95em;
    background: white;
  }

  .domain-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 14px;
  }

  .domain-pill {
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: white;
    font-size: 0.85em;
    cursor: pointer;
    font-weight: 600;
    color: var(--text-muted);
  }

  .domain-pill.active {
    background: var(--accent);
    color: white;
    border-color: var(--accent);
  }

  .result-counter {
    font-size: 0.9em;
    color: var(--text-muted);
    margin-bottom: 16px;
    font-weight: 600;
  }

  /* Question card (study mode) */
  .question {
    background: white;
    padding: 20px;
    margin-bottom: 16px;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    border: 1px solid var(--border);
  }

  .domain {
    background: var(--accent);
    color: white;
    display: inline-block;
    padding: 4px 10px;
    border-radius: 5px;
    font-size: 0.78em;
    margin-bottom: 10px;
    font-weight: 600;
  }

  .domain.type-tag {
    background: #64748b;
    margin-left: 6px;
  }

  .question-text {
    font-size: 1.05em;
    font-weight: 600;
    margin-bottom: 14px;
    color: var(--text);
  }

  .options-list {
    list-style: none;
    padding: 0;
    margin: 0 0 12px;
  }

  .options-list li {
    background: #f9fafb;
    border: 1px solid var(--border);
    padding: 10px 14px;
    margin-bottom: 8px;
    border-radius: 6px;
  }

  .options-list li.correct-option {
    background: var(--green-bg);
    border-color: var(--green-border);
    color: var(--green-text);
    font-weight: 600;
  }

  .show-answer-btn {
    background: var(--accent);
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.9em;
  }

  .show-answer-btn:hover { background: var(--accent-dark); }

  .answer-block {
    display: none;
    margin-top: 12px;
    padding: 14px;
    background: var(--accent-light);
    border-radius: 8px;
    border: 1px solid #c7d2fe;
  }

  .answer-block.visible { display: block; }

  .answer-block .correct-label {
    font-weight: 700;
    color: var(--accent-dark);
    margin-bottom: 6px;
  }

  .answer-block .explanation-text {
    color: var(--text);
    font-size: 0.95em;
  }

  /* Buttons general */
  .btn {
    background: var(--accent);
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.95em;
    transition: background 0.15s;
  }

  .btn:hover { background: var(--accent-dark); }
  .btn:disabled { background: #9ca3af; cursor: not-allowed; }

  .btn.secondary {
    background: white;
    color: var(--accent);
    border: 1px solid var(--accent);
  }

  .btn.secondary:hover { background: var(--accent-light); }

  .btn.danger {
    background: var(--red);
  }

  .btn.danger:hover { background: #dc2626; }

  /* Exam setup */
  .exam-setup-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-bottom: 20px;
  }

  .form-group label {
    display: block;
    font-weight: 600;
    margin-bottom: 6px;
    font-size: 0.9em;
    color: var(--text-muted);
  }

  .form-group select, .form-group input[type="number"] {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 0.95em;
  }

  .checkbox-group {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
  }

  /* Exam runner */
  .exam-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: white;
    padding: 14px 20px;
    border-radius: var(--radius);
    margin-bottom: 16px;
    box-shadow: var(--shadow);
    font-weight: 600;
    flex-wrap: wrap;
    gap: 10px;
  }

  .exam-header-bar .timer {
    color: var(--accent-dark);
  }

  .progress-bar-outer {
    background: #e5e7eb;
    border-radius: 999px;
    height: 8px;
    overflow: hidden;
    margin-bottom: 16px;
  }

  .progress-bar-inner {
    background: var(--accent);
    height: 100%;
    transition: width 0.2s;
  }

  .exam-nav-buttons {
    display: flex;
    justify-content: space-between;
    margin-top: 20px;
    gap: 10px;
    flex-wrap: wrap;
  }

  .exam-option-label {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    background: #f9fafb;
    border: 1px solid var(--border);
    padding: 12px 14px;
    margin-bottom: 8px;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.15s;
  }

  .exam-option-label:hover { background: var(--accent-light); }

  .exam-option-label input { margin-top: 3px; }

  /* Review list (post exam) */
  .review-item {
    background: white;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 18px 20px;
    margin-bottom: 14px;
    border-left: 5px solid var(--border);
  }

  .review-item.correct { border-left-color: var(--green); }
  .review-item.incorrect { border-left-color: var(--red); }

  .review-item .your-answer { color: var(--red-text); font-weight: 600; }
  .review-item .your-answer.was-correct { color: var(--green-text); }
  .review-item .correct-answer { color: var(--green-text); font-weight: 600; }

  /* Score summary card */
  .score-summary {
    text-align: center;
    padding: 30px 20px;
  }

  .score-summary .big-score {
    font-size: 3em;
    font-weight: 800;
    color: var(--accent-dark);
  }

  .score-summary .pass-badge {
    display: inline-block;
    padding: 8px 20px;
    border-radius: 999px;
    font-weight: 700;
    margin-top: 10px;
    font-size: 1.1em;
  }

  .pass-badge.pass { background: var(--green-bg); color: var(--green-text); }
  .pass-badge.fail { background: var(--red-bg); color: var(--red-text); }

  table.domain-breakdown {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
  }

  table.domain-breakdown th, table.domain-breakdown td {
    text-align: left;
    padding: 10px 12px;
    border-bottom: 1px solid var(--border);
  }

  table.domain-breakdown th {
    background: #f9fafb;
    font-weight: 700;
    color: var(--text-muted);
    font-size: 0.85em;
    text-transform: uppercase;
  }

  /* Scoring dashboard */
  .score-card {
    background: var(--card-bg);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 24px;
    margin-bottom: 20px;
  }

  .score-input-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
    margin-bottom: 18px;
  }

  .badge {
    display: inline-block;
    padding: 5px 12px;
    border-radius: 999px;
    font-size: 0.8em;
    font-weight: 700;
  }

  .badge.ready { background: var(--green-bg); color: var(--green-text); }
  .badge.nearly { background: #dbeafe; color: #1e40af; }
  .badge.developing { background: var(--amber-bg); color: var(--amber-text); }
  .badge.review { background: var(--red-bg); color: var(--red-text); }

  .progress-track {
    background: #e5e7eb;
    border-radius: 999px;
    height: 22px;
    overflow: hidden;
    position: relative;
    margin: 10px 0;
  }

  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--accent), var(--accent-dark));
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 0.8em;
    font-weight: 700;
    transition: width 0.3s;
  }

  .readiness-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 14px;
    margin-top: 20px;
  }

  .readiness-card {
    padding: 16px;
    border-radius: 10px;
    border: 2px solid transparent;
  }

  .readiness-card.tier-ready { background: var(--green-bg); border-color: var(--green-border); }
  .readiness-card.tier-nearly { background: #dbeafe; border-color: #93c5fd; }
  .readiness-card.tier-developing { background: var(--amber-bg); border-color: var(--amber-border); }
  .readiness-card.tier-review { background: var(--red-bg); border-color: var(--red-border); }

  .readiness-card h4 { margin: 0 0 6px; }
  .readiness-card p { margin: 0; font-size: 0.88em; color: var(--text); }

  .attempt-history-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 14px;
    font-size: 0.9em;
  }

  .attempt-history-table th, .attempt-history-table td {
    padding: 8px 10px;
    border-bottom: 1px solid var(--border);
    text-align: left;
  }

  .attempt-history-table th {
    background: #f9fafb;
    font-size: 0.8em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .action-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 16px;
  }

  .empty-state {
    text-align: center;
    color: var(--text-muted);
    padding: 30px 10px;
    font-style: italic;
  }

  .section-title {
    font-size: 1.2em;
    font-weight: 700;
    margin: 0 0 14px;
    color: var(--text);
  }

  .confirm-banner {
    background: var(--amber-bg);
    border: 1px solid var(--amber-border);
    color: var(--amber-text);
    padding: 14px 18px;
    border-radius: 8px;
    margin-bottom: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* Print rules */
  @media print {
    .main-nav, .study-controls, .domain-pills, .show-answer-btn,
    button, input, select, .exam-nav-buttons, .action-row,
    .confirm-banner { display: none !important; }

    .answer-block { display: block !important; }

    body { background: white; }

    .question, .review-item, .card, .score-card {
      box-shadow: none;
      border: 1px solid #ccc;
      break-inside: avoid;
    }

    .view-section { display: block !important; }
  }
</style>
</head>

<body>
<header class="app-header">
  <h1>Claude Certified Architect Foundations (CCA-F) — Exam Simulator</h1>
  <p class="subtitle">Full study reviewer and mock exam engine — 250 questions across 5 domains</p>
</header>

<div class="app-container">

  <nav class="main-nav">
    <button id="nav-study" class="active" onclick="showView('study')">Study Mode</button>
    <button id="nav-exam" onclick="showView('exam')">Mock Exam</button>
    <button id="nav-scoring" onclick="showView('scoring')">Scoring Dashboard</button>
  </nav>

  <!-- ============ STUDY MODE ============ -->
  <section id="view-study" class="view-section active">
    <div class="card">
      <div class="study-controls">
        <input type="text" id="study-search" placeholder="Search questions by keyword..." oninput="renderStudyList()">
        <select id="study-domain-select" onchange="onDomainSelectChange()">
          <option value="all">All Domains</option>
          <option value="Agentic Architecture">Agentic Architecture</option>
          <option value="MCP &amp; Tool Design">MCP &amp; Tool Design</option>
          <option value="Claude Code &amp; Skills">Claude Code &amp; Skills</option>
          <option value="Prompt Engineering">Prompt Engineering</option>
          <option value="Context &amp; Reliability">Context &amp; Reliability</option>
        </select>
      </div>
      <div class="domain-pills" id="domain-pills"></div>
      <div class="result-counter" id="study-counter">Showing 250 of 250 questions</div>
    </div>

    <div id="study-list"></div>
  </section>

  <!-- ============ MOCK EXAM MODE ============ -->
  <section id="view-exam" class="view-section">

    <div class="card" id="exam-setup-card">
      <div class="section-title">Configure Your Mock Exam</div>
      <div class="exam-setup-grid">
        <div class="form-group">
          <label for="exam-length">Number of Questions</label>
          <select id="exam-length">
            <option value="25">25 Questions</option>
            <option value="50" selected>50 Questions</option>
            <option value="100">100 Questions</option>
            <option value="250">250 Questions (Full Exam)</option>
          </select>
        </div>
        <div class="form-group">
          <label for="exam-pass-threshold">Passing Threshold (%)</label>
          <input type="number" id="exam-pass-threshold" value="80" min="1" max="100">
        </div>
        <div class="form-group">
          <label>&nbsp;</label>
          <div class="checkbox-group">
            <input type="checkbox" id="exam-randomize" checked>
            <label for="exam-randomize" style="margin:0; font-weight:500;">Randomize question order</label>
          </div>
        </div>
      </div>
      <button class="btn" onclick="startExam()">Start Exam</button>
    </div>

    <div class="card" id="exam-confirm-card" style="display:none;">
      <div class="confirm-banner">
        <span>Are you sure you want to submit the exam? You cannot change answers after submitting.</span>
        <div>
          <button class="btn secondary" onclick="cancelSubmit()">Cancel</button>
          <button class="btn danger" onclick="confirmSubmitExam()">Yes, Submit Exam</button>
        </div>
      </div>
    </div>

    <div id="exam-runner" style="display:none;">
      <div class="exam-header-bar">
        <div id="exam-question-counter">Question 1 of 50</div>
        <div class="timer" id="exam-timer">Time Elapsed: 00:00</div>
      </div>
      <div class="progress-bar-outer">
        <div class="progress-bar-inner" id="exam-progress-bar" style="width:0%"></div>
      </div>

      <div class="card">
        <span class="domain" id="exam-q-domain">Domain</span>
        <span class="domain type-tag" id="exam-q-type">Single Answer</span>
        <div class="question-text" id="exam-q-text"></div>
        <div id="exam-q-options"></div>
      </div>

      <div class="exam-nav-buttons">
        <div>
          <button class="btn secondary" id="exam-prev-btn" onclick="examPrev()">Previous</button>
          <button class="btn secondary" id="exam-next-btn" onclick="examNext()">Next</button>
        </div>
        <button class="btn danger" onclick="requestSubmitExam()">Submit Exam</button>
      </div>
    </div>

    <div id="exam-results" style="display:none;">
      <div class="card score-summary">
        <div style="color: var(--text-muted); font-weight:600;">Your Score</div>
        <div class="big-score" id="exam-result-score">0%</div>
        <div id="exam-result-fraction" style="color: var(--text-muted);">0 / 0 correct</div>
        <div class="pass-badge" id="exam-result-badge">PASS</div>
      </div>

      <div class="card">
        <div class="section-title">Domain Breakdown</div>
        <table class="domain-breakdown">
          <thead>
            <tr><th>Domain</th><th>Correct</th><th>Total</th><th>Percentage</th></tr>
          </thead>
          <tbody id="exam-domain-breakdown-body"></tbody>
        </table>
      </div>

      <div class="card">
        <div class="section-title">Full Review</div>
        <div id="exam-review-list"></div>
      </div>

      <div class="card">
        <button class="btn" onclick="startOverExam()">Start New Exam</button>
      </div>
    </div>
  </section>

  <!-- ============ SCORING DASHBOARD ============ -->
  <section id="view-scoring" class="view-section">
    <div id="scoring-section">
      <div class="score-card">
        <div class="section-title">Practice Score Calculator</div>
        <div class="score-input-grid">
          <div class="form-group">
            <label for="attempt-date">Date</label>
            <input type="date" id="attempt-date">
          </div>
          <div class="form-group">
            <label for="correctAnswers">Correct Answers</label>
            <input type="number" id="correctAnswers" min="0" value="0">
          </div>
          <div class="form-group">
            <label for="totalQuestions">Total Questions</label>
            <input type="number" id="totalQuestions" min="1" value="250">
          </div>
        </div>
        <button class="btn" onclick="calculatePracticeScore()">Calculate Score</button>

        <div id="practice-score-output" style="display:none; margin-top:20px;">
          <div class="progress-track">
            <div class="progress-fill" id="practice-progress-fill" style="width:0%">0%</div>
          </div>
          <div style="text-align:center; margin-top:8px;">
            <span class="badge" id="practice-readiness-badge">—</span>
          </div>
        </div>
      </div>

      <div class="score-card">
        <div class="section-title">Domain Score Breakdown</div>
        <table class="attempt-history-table" id="domain-score-table">
          <thead>
            <tr><th>Domain</th><th>Correct</th><th>Total</th><th>%</th></tr>
          </thead>
          <tbody>
            <tr>
              <td>Agentic Architecture</td>
              <td><input type="number" id="d1CorrectScore" min="0" value="0" style="width:70px;"></td>
              <td><input type="number" id="d1TotalScore" min="0" value="68" style="width:70px;"></td>
              <td id="d1PercentDisplay">0%</td>
            </tr>
            <tr>
              <td>MCP &amp; Tool Design</td>
              <td><input type="number" id="d2CorrectScore" min="0" value="0" style="width:70px;"></td>
              <td><input type="number" id="d2TotalScore" min="0" value="45" style="width:70px;"></td>
              <td id="d2PercentDisplay">0%</td>
            </tr>
            <tr>
              <td>Claude Code &amp; Skills</td>
              <td><input type="number" id="d3CorrectScore" min="0" value="0" style="width:70px;"></td>
              <td><input type="number" id="d3TotalScore" min="0" value="50" style="width:70px;"></td>
              <td id="d3PercentDisplay">0%</td>
            </tr>
            <tr>
              <td>Prompt Engineering</td>
              <td><input type="number" id="d4CorrectScore" min="0" value="0" style="width:70px;"></td>
              <td><input type="number" id="d4TotalScore" min="0" value="50" style="width:70px;"></td>
              <td id="d4PercentDisplay">0%</td>
            </tr>
            <tr>
              <td>Context &amp; Reliability</td>
              <td><input type="number" id="d5CorrectScore" min="0" value="0" style="width:70px;"></td>
              <td><input type="number" id="d5TotalScore" min="0" value="37" style="width:70px;"></td>
              <td id="d5PercentDisplay">0%</td>
            </tr>
          </tbody>
        </table>
        <button class="btn secondary" onclick="calculateDomainScores()" style="margin-top:12px;">Update Domain Percentages</button>
      </div>

      <div class="score-card">
        <div class="action-row">
          <button class="btn" onclick="saveCurrentAttempt()">Save Current Attempt</button>
