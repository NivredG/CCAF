function escapeHtml(str) {
  if (str === null || str === undefined) return "";
  return String(str)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");
}

function arraysEqualUnordered(a, b) {
  if (!Array.isArray(a) || !Array.isArray(b)) return false;
  if (a.length !== b.length) return false;
  const sa = [...a].map(Number).sort((x, y) => x - y);
  const sb = [...b].map(Number).sort((x, y) => x - y);
  return sa.every((v, i) => v === sb[i]);
}

function letterFor(index) {
  return String.fromCharCode(65 + index); // 0 -> A, 1 -> B, ...
}

/* ============================================================
   Top-level Navigation
   ============================================================ */

function showView(name) {
  const views = ["study", "exam", "scoring"];
  views.forEach(v => {
    document.getElementById("view-" + v).classList.toggle("active", v === name);
    document.getElementById("nav-" + v).classList.toggle("active", v === name);
  });
  if (name === "scoring") {
    renderAttemptHistory();
  }
}

/* ============================================================
   STUDY MODE
   ============================================================ */

let currentStudyDomain = "all";

function initDomainPills() {
  const container = document.getElementById("domain-pills");
  const all = [{ name: "all", label: "All Domains" }].concat(
    DOMAINS.map(d => ({ name: d, label: d }))
  );
  container.innerHTML = all.map(d =>
    `<button type="button" class="domain-pill${d.name === "all" ? " active" : ""}" data-domain="${escapeHtml(d.name)}" onclick="selectDomainPill('${escapeHtml(d.name).replace(/'/g, "\\'")}')">${escapeHtml(d.label)}</button>`
  ).join("");
}

function selectDomainPill(domainName) {
  currentStudyDomain = domainName;
  document.getElementById("study-domain-select").value = domainName;
  document.querySelectorAll(".domain-pill").forEach(btn => {
    btn.classList.toggle("active", btn.getAttribute("data-domain") === domainName);
  });
  renderStudyList();
}

function onDomainSelectChange() {
  const val = document.getElementById("study-domain-select").value;
  selectDomainPill(val);
}

function renderStudyList() {
  const searchTerm = document.getElementById("study-search").value.trim().toLowerCase();
  const domainFilter = currentStudyDomain;

  const filtered = QUESTIONS.filter(q => {
    const matchesDomain = domainFilter === "all" || q.domain === domainFilter;
    if (!matchesDomain) return false;
    if (!searchTerm) return true;
    const haystack = (q.question + " " + q.options.join(" ") + " " + q.explanation).toLowerCase();
    return haystack.indexOf(searchTerm) !== -1;
  });

  document.getElementById("study-counter").textContent =
    `Showing ${filtered.length} of ${QUESTIONS.length} questions`;

  const listEl = document.getElementById("study-list");

  if (filtered.length === 0) {
    listEl.innerHTML = `<div class="card"><div class="empty-state">No questions match your search/filter.</div></div>`;
    return;
  }

  listEl.innerHTML = filtered.map(q => {
    const optionsHtml = q.options.map((opt, i) => {
      const isCorrect = q.type === "multi" ? q.correctAnswer.includes(i) : q.correctAnswer === i;
      return `<li data-correct="${isCorrect ? "1" : "0"}">${letterFor(i)}. ${escapeHtml(opt)}</li>`;
    }).join("");

    const correctLabel = q.type === "multi"
      ? q.correctAnswer.map(i => letterFor(i)).join(", ")
      : letterFor(q.correctAnswer);

    return `
      <div class="question">
        <span class="domain">${escapeHtml(q.domain)}</span>
        <span class="domain type-tag">${q.type === "multi" ? "Choose TWO" : "Single Answer"}</span>
        <span class="domain type-tag" style="background:#94a3b8;">#${q.id}</span>
        <div class="question-text">${escapeHtml(q.question)}</div>
        <ul class="options-list">${optionsHtml}</ul>
        <button class="show-answer-btn" onclick="toggleAnswer(this)">Show Answer</button>
        <div class="answer-block">
          <div class="correct-label">Correct Answer: ${correctLabel}</div>
          <div class="explanation-text">${escapeHtml(q.explanation)}</div>
        </div>
      </div>
    `;
  }).join("");
}

function toggleAnswer(btn) {
  const block = btn.nextElementSibling;
  const visible = block.classList.toggle("visible");
  btn.textContent = visible ? "Hide Answer" : "Show Answer";

  const questionCard = btn.closest(".question");
  if (questionCard) {
    const optionItems = questionCard.querySelectorAll(".options-list li");
    optionItems.forEach(li => {
      li.classList.toggle("correct-option", visible && li.getAttribute("data-correct") === "1");
    });
  }
}

/* ============================================================
   MOCK EXAM MODE
   ============================================================ */

let examState = null; // { questions: [...], answers: {index: value}, currentIndex, startTime, timerInterval, passThreshold }

function shuffleArray(arr) {
  const a = arr.slice();
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

function startExam() {
  const length = parseInt(document.getElementById("exam-length").value, 10);
  const randomize = document.getElementById("exam-randomize").checked;
  const passThreshold = parseInt(document.getElementById("exam-pass-threshold").value, 10) || 80;

  let pool = QUESTIONS.slice();
  if (randomize) {
    pool = shuffleArray(pool);
  }
  const selected = pool.slice(0, Math.min(length, pool.length));

  examState = {
    questions: selected,
    answers: {}, // index -> number (single) or array (multi)
    currentIndex: 0,
    startTime: Date.now(),
    timerInterval: null,
    passThreshold: passThreshold
  };

  document.getElementById("exam-setup-card").style.display = "none";
  document.getElementById("exam-confirm-card").style.display = "none";
  document.getElementById("exam-results").style.display = "none";
  document.getElementById("exam-runner").style.display = "block";

  examState.timerInterval = setInterval(updateExamTimer, 1000);
  updateExamTimer();
  renderExamQuestion();
}

function updateExamTimer() {
  if (!examState) return;
  const elapsedMs = Date.now() - examState.startTime;
  const totalSeconds = Math.floor(elapsedMs / 1000);
  const mins = Math.floor(totalSeconds / 60).toString().padStart(2, "0");
  const secs = (totalSeconds % 60).toString().padStart(2, "0");
  document.getElementById("exam-timer").textContent = `Time Elapsed: ${mins}:${secs}`;
}

function renderExamQuestion() {
  const { questions, currentIndex, answers } = examState;
  const q = questions[currentIndex];

  document.getElementById("exam-question-counter").textContent =
    `Question ${currentIndex + 1} of ${questions.length}`;
  document.getElementById("exam-progress-bar").style.width =
    `${((currentIndex + 1) / questions.length) * 100}%`;

  document.getElementById("exam-q-domain").textContent = q.domain;
  document.getElementById("exam-q-type").textContent = q.type === "multi" ? "Choose TWO" : "Single Answer";
  document.getElementById("exam-q-text").textContent = q.question;

  const existingAnswer = answers[currentIndex];
  const optsContainer = document.getElementById("exam-q-options");

  if (q.type === "multi") {
    optsContainer.innerHTML = q.options.map((opt, i) => {
      const checked = Array.isArray(existingAnswer) && existingAnswer.includes(i) ? "checked" : "";
      return `
        <label class="exam-option-label">
          <input type="checkbox" name="exam-opt" value="${i}" ${checked} onchange="onExamMultiChange()">
          <span>${letterFor(i)}. ${escapeHtml(opt)}</span>
        </label>`;
    }).join("");
  } else {
    optsContainer.innerHTML = q.options.map((opt, i) => {
      const checked = existingAnswer === i ? "checked" : "";
      return `
        <label class="exam-option-label">
          <input type="radio" name="exam-opt" value="${i}" ${checked} onchange="onExamSingleChange(${i})">
          <span>${letterFor(i)}. ${escapeHtml(opt)}</span>
        </label>`;
    }).join("");
  }

  document.getElementById("exam-prev-btn").disabled = currentIndex === 0;
  document.getElementById("exam-next-btn").textContent =
    currentIndex === questions.length - 1 ? "Next" : "Next";
}

function onExamSingleChange(value) {
  examState.answers[examState.currentIndex] = value;
}

function onExamMultiChange() {
  const checked = Array.from(document.querySelectorAll('input[name="exam-opt"]:checked'))
    .map(el => parseInt(el.value, 10));
  examState.answers[examState.currentIndex] = checked;
}

function examPrev() {
  if (examState.currentIndex > 0) {
    examState.currentIndex--;
    renderExamQuestion();
  }
}

function examNext() {
  if (examState.currentIndex < examState.questions.length - 1) {
    examState.currentIndex++;
    renderExamQuestion();
  }
}

function requestSubmitExam() {
  document.getElementById("exam-confirm-card").style.display = "block";
  document.getElementById("exam-confirm-card").scrollIntoView({ behavior: "smooth", block: "center" });
}

function cancelSubmit() {
  document.getElementById("exam-confirm-card").style.display = "none";
}

let lastExamResult = null; // stores { overallPct, correctCount, total, domainStats, passed, passThreshold }

function confirmSubmitExam() {
  clearInterval(examState.timerInterval);
  document.getElementById("exam-confirm-card").style.display = "none";
  document.getElementById("exam-runner").style.display = "none";

  const { questions, answers, passThreshold } = examState;

  let correctCount = 0;
  const domainStats = {}; // domain -> { correct, total }
  DOMAINS.forEach(d => { domainStats[d] = { correct: 0, total: 0 }; });

  const reviewRows = questions.map((q, idx) => {
    const userAnswer = answers[idx];
    let isCorrect;
    if (q.type === "multi") {
      isCorrect = Array.isArray(userAnswer) && arraysEqualUnordered(userAnswer, q.correctAnswer);
    } else {
      isCorrect = userAnswer === q.correctAnswer;
    }
    if (isCorrect) correctCount++;

    domainStats[q.domain].total++;
    if (isCorrect) domainStats[q.domain].correct++;

    return { q, userAnswer, isCorrect };
  });

  const total = questions.length;
  const overallPct = total > 0 ? Math.round((correctCount / total) * 1000) / 10 : 0;
  const passed = overallPct >= passThreshold;

  lastExamResult = { overallPct, correctCount, total, domainStats, passed, passThreshold, reviewRows };

  renderExamResults(lastExamResult);
  document.getElementById("exam-results").style.display = "block";
  document.getElementById("exam-results").scrollIntoView({ behavior: "smooth", block: "start" });
}

function renderExamResults(result) {
  document.getElementById("exam-result-score").textContent = `${result.overallPct}%`;
  document.getElementById("exam-result-fraction").textContent =
    `${result.correctCount} / ${result.total} correct`;

  const badge = document.getElementById("exam-result-badge");
  badge.textContent = result.passed ? `PASS (≥ ${result.passThreshold}%)` : `FAIL (< ${result.passThreshold}%)`;
  badge.className = "pass-badge " + (result.passed ? "pass" : "fail");

  const breakdownBody = document.getElementById("exam-domain-breakdown-body");
  breakdownBody.innerHTML = DOMAINS.map(d => {
    const stat = result.domainStats[d];
    if (!stat || stat.total === 0) {
      return `<tr><td>${escapeHtml(d)}</td><td>0</td><td>0</td><td>—</td></tr>`;
    }
    const pct = Math.round((stat.correct / stat.total) * 1000) / 10;
    return `<tr><td>${escapeHtml(d)}</td><td>${stat.correct}</td><td>${stat.total}</td><td>${pct}%</td></tr>`;
  }).join("");

  const reviewList = document.getElementById("exam-review-list");
  reviewList.innerHTML = result.reviewRows.map(({ q, userAnswer, isCorrect }) => {
    const optionsHtml = q.options.map((opt, i) => {
      const isCorrectOpt = q.type === "multi" ? q.correctAnswer.includes(i) : q.correctAnswer === i;
      return `<li class="${isCorrectOpt ? "correct-option" : ""}">${letterFor(i)}. ${escapeHtml(opt)}</li>`;
    }).join("");

    let userAnswerLabel;
    if (userAnswer === undefined || userAnswer === null || (Array.isArray(userAnswer) && userAnswer.length === 0)) {
      userAnswerLabel = "No answer given";
    } else if (Array.isArray(userAnswer)) {
      userAnswerLabel = userAnswer.map(i => letterFor(i)).join(", ");
    } else {
      userAnswerLabel = letterFor(userAnswer);
    }

    const correctLabel = q.type === "multi"
      ? q.correctAnswer.map(i => letterFor(i)).join(", ")
      : letterFor(q.correctAnswer);

    return `
      <div class="review-item ${isCorrect ? "correct" : "incorrect"}">
        <span class="domain">${escapeHtml(q.domain)}</span>
        <span class="domain type-tag">#${q.id}</span>
        <div class="question-text">${escapeHtml(q.question)}</div>
        <ul class="options-list">${optionsHtml}</ul>
        <div class="${isCorrect ? "your-answer was-correct" : "your-answer"}">Your answer: ${userAnswerLabel}</div>
        <div class="correct-answer">Correct answer: ${correctLabel}</div>
        <div class="explanation-text" style="margin-top:8px;">${escapeHtml(q.explanation)}</div>
      </div>
    `;
  }).join("");

  populateScoringFromExam(result);
}

function startOverExam() {
  document.getElementById("exam-results").style.display = "none";
  document.getElementById("exam-setup-card").style.display = "block";
  examState = null;
}

/* Auto-populate scoring dashboard from mock exam results */
function populateScoringFromExam(result) {
  document.getElementById("correctAnswers").value = result.correctCount;
  document.getElementById("totalQuestions").value = result.total;

  DOMAINS.forEach(d => {
    const key = DOMAIN_KEY_MAP[d];
    const stat = result.domainStats[d];
    if (stat) {
      document.getElementById(key + "CorrectScore").value = stat.correct;
      document.getElementById(key + "TotalScore").value = stat.total;
    }
  });

  calculateDomainScores();
  calculatePracticeScore();
}

/* ============================================================
   SCORING DASHBOARD
   ============================================================ */

const ATTEMPTS_KEY = "ccafPracticeAttempts";

function calculatePracticeScore() {
  const correct = parseFloat(document.getElementById("correctAnswers").value) || 0;
  const total = parseFloat(document.getElementById("totalQuestions").value) || 0;

  const pct = total > 0 ? Math.round((correct / total) * 1000) / 10 : 0;

  const output = document.getElementById("practice-score-output");
  output.style.display = "block";

  const fill = document.getElementById("practice-progress-fill");
  fill.style.width = Math.min(pct, 100) + "%";
  fill.textContent = pct + "%";

  const badge = document.getElementById("practice-readiness-badge");
  const tier = readinessTier(pct);
  badge.textContent = tier.label;
  badge.className = "badge " + tier.cssClass;

  return pct;
}

function readinessTier(pct) {
  if (pct >= 90) return { label: "Exam Ready (90-100%)", cssClass: "ready" };
  if (pct >= 80) return { label: "Nearly Ready (80-89%)", cssClass: "nearly" };
  if (pct >= 70) return { label: "Developing (70-79%)", cssClass: "developing" };
  return { label: "Review Required (<70%)", cssClass: "review" };
}

function calculateDomainScores() {
  let totalCorrect = 0;
  let totalQuestions = 0;

  DOMAINS.forEach(d => {
    const key = DOMAIN_KEY_MAP[d];
    const correctEl = document.getElementById(key + "CorrectScore");
    const totalEl = document.getElementById(key + "TotalScore");
    const percentEl = document.getElementById(key + "PercentDisplay");

    const correct = parseFloat(correctEl.value) || 0;
    const total = parseFloat(totalEl.value) || 0;
    const pct = total > 0 ? Math.round((correct / total) * 1000) / 10 : 0;

    percentEl.textContent = pct + "%";

    totalCorrect += correct;
    totalQuestions += total;
  });

  return { totalCorrect, totalQuestions };
}

function resetPracticeScore() {
  document.getElementById("correctAnswers").value = 0;
  document.getElementById("totalQuestions").value = 250;
  DOMAINS.forEach(d => {
    const key = DOMAIN_KEY_MAP[d];
    document.getElementById(key + "CorrectScore").value = 0;
  });
  calculateDomainScores();
  document.getElementById("practice-score-output").style.display = "none";
}

function saveCurrentAttempt() {
  const dateVal = document.getElementById("attempt-date").value || new Date().toISOString().slice(0, 10);
  const correct = parseFloat(document.getElementById("correctAnswers").value) || 0;
  const total = parseFloat(document.getElementById("totalQuestions").value) || 0;
  const pct = total > 0 ? Math.round((correct / total) * 1000) / 10 : 0;

  const domainSnapshot = {};
  DOMAINS.forEach(d => {
    const key = DOMAIN_KEY_MAP[d];
    const dCorrect = parseFloat(document.getElementById(key + "CorrectScore").value) || 0;
    const dTotal = parseFloat(document.getElementById(key + "TotalScore").value) || 0;
    domainSnapshot[d] = { correct: dCorrect, total: dTotal };
  });

  const attempt = {
    date: dateVal,
    correct: correct,
    total: total,
    percentage: pct,
    domains: domainSnapshot,
    savedAt: new Date().toISOString()
  };

  const attempts = loadAttempts();
  attempts.push(attempt);
  localStorage.setItem(ATTEMPTS_KEY, JSON.stringify(attempts));

  renderAttemptHistory();
}

function loadAttempts() {
  try {
    const raw = localStorage.getItem(ATTEMPTS_KEY);
    if (!raw) return [];
    const parsed = JSON.parse(raw);
    return Array.isArray(parsed) ? parsed : [];
  } catch (e) {
    return [];
  }
}

function renderAttemptHistory() {
  const attempts = loadAttempts();
  const container = document.getElementById("attempt-history-container");

  if (attempts.length === 0) {
    container.innerHTML = `<div class="empty-state">No attempts saved yet. Calculate and save a score to begin tracking your progress.</div>`;
    return;
  }

  const rows = attempts.slice().reverse().map(a => {
    const tier = readinessTier(a.percentage);
    return `
      <tr>
        <td>${escapeHtml(a.date)}</td>
        <td>${a.correct} / ${a.total}</td>
        <td>${a.percentage}%</td>
        <td><span class="badge ${tier.cssClass}">${tier.label}</span></td>
      </tr>
    `;
  }).join("");

  container.innerHTML = `
    <table class="attempt-history-table">
      <thead>
        <tr><th>Date</th><th>Score</th><th>Percentage</th><th>Readiness</th></tr>
      </thead>
      <tbody>${rows}</tbody>
    </table>
  `;
}

function clearAttemptHistory() {
  const confirmed = confirm("Are you sure you want to permanently clear all saved practice attempt history? This cannot be undone.");
  if (!confirmed) return;
  localStorage.removeItem(ATTEMPTS_KEY);
  renderAttemptHistory();
}

function printPracticeResults() {
  window.print();
}

/* ============================================================
   INIT
   ============================================================ */

document.addEventListener("DOMContentLoaded", function () {
  const dateInput = document.getElementById("attempt-date");
  if (dateInput) {
    dateInput.value = new Date().toISOString().slice(0, 10);
  }

  initDomainPills();
  renderStudyList();
  calculateDomainScores();
  renderAttemptHistory();
});
</script>
